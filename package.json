{
  "name": "extension-pack-for-brainfuck",
  "displayName": "Extension Pack for Brainfuck",
  "description": "The all-in-one, zero-dependency Brainfuck development studio & visual debugger for VS Code.",
  "version": "0.1.5",
  "publisher": "Ohualtex",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohualtex/Brainfuck.git"
  },
  "homepage": "https://github.com/Ohualtex/Brainfuck#readme",
  "bugs": {
    "url": "https://github.com/Ohualtex/Brainfuck/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "brainfuck",
    "bf",
    "esoteric",
    "debugger",
    "visualizer"
  ],
  "activationEvents": [
    "onLanguage:brainfuck",
    "onWebviewPanel:brainfuckTapeVisualizer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "brainfuck",
        "aliases": [
          "Brainfuck",
          "brainfuck",
          "bf"
        ],
        "extensions": [
          ".bf",
          ".b"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/brainfuck-file-icon.svg",
          "dark": "./icons/brainfuck-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "brainfuck",
        "scopeName": "source.brainfuck",
        "path": "./syntaxes/brainfuck.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "brainfuck",
        "path": "./snippets/brainfuck.json"
      }
    ],
    "iconThemes": [
      {
        "id": "brainfuck-icon-theme",
        "label": "Brainfuck (Official)",
        "path": "./icons/brainfuck-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "brainfuck.openVisualTape",
        "title": "Brainfuck: Open Visual Tape Debugger",
        "icon": "$(play-circle)",
        "category": "Brainfuck"
      },
      {
        "command": "brainfuck.run",
        "title": "Brainfuck: Run Code in Output Channel",
        "icon": "$(run)",
        "category": "Brainfuck"
      },
      {
        "command": "brainfuck.format",
        "title": "Brainfuck: Format / Indent Loops",
        "category": "Brainfuck"
      },
      {
        "command": "brainfuck.minify",
        "title": "Brainfuck: Minify Code",
        "category": "Brainfuck"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "brainfuck.openVisualTape",
          "when": "resourceLangId == brainfuck",
          "group": "navigation@1"
        },
        {
          "command": "brainfuck.run",
          "when": "resourceLangId == brainfuck",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "brainfuck.openVisualTape",
          "when": "resourceLangId == brainfuck",
          "group": "brainfuck@1"
        },
        {
          "command": "brainfuck.run",
          "when": "resourceLangId == brainfuck",
          "group": "brainfuck@2"
        },
        {
          "command": "brainfuck.format",
          "when": "resourceLangId == brainfuck",
          "group": "brainfuck@3"
        },
        {
          "command": "brainfuck.minify",
          "when": "resourceLangId == brainfuck",
          "group": "brainfuck@4"
        }
      ]
    },
    "configurationDefaults": {
      "[brainfuck]": {
        "editor.maxTokenizationLineLength": 500000,
        "editor.wordWrap": "on"
      }
    },
    "configuration": {
      "title": "Brainfuck",
      "properties": {
        "brainfuck.tapeSize": {
          "type": "number",
          "default": 30000,
          "description": "Size of the Brainfuck memory tape in cells."
        },
        "brainfuck.cellWrapping": {
          "type": "boolean",
          "default": true,
          "description": "Whether 8-bit cells wrap around between 0 and 255."
        },
        "brainfuck.defaultRunDelayMs": {
          "type": "number",
          "default": 30,
          "description": "Default execution delay (ms) per instruction in visual tape auto-run."
        },
        "brainfuck.debugger.outputHeight": {
          "type": "number",
          "default": 140,
          "description": "Height in pixels of the visual debugger terminal output console."
        },
        "brainfuck.debugger.syncEditorOnStep": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the active instruction in the VS Code text editor during visual debugging."
        },
        "brainfuck.debugger.visibleCells": {
          "type": "number",
          "default": 50,
          "description": "Number of tape memory cells visible in the viewport around the active pointer."
        },
        "brainfuck.format.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces or indentation per nested loop level when formatting."
        },
        "brainfuck.format.insertSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Indent using spaces instead of tabs when formatting."
        },
        "brainfuck.execution.maxSteps": {
          "type": "number",
          "default": 5000000,
          "description": "Maximum execution steps in Output Channel before stopping to prevent infinite loops."
        },
        "brainfuck.execution.clearPreviousOutput": {
          "type": "boolean",
          "default": false,
          "description": "Clear the Output Channel before executing a Brainfuck program."
        },
        "brainfuck.execution.showSummary": {
          "type": "boolean",
          "default": true,
          "description": "Show execution metrics summary (steps, duration, cell value) upon completion in Output Channel."
        },
        "brainfuck.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time syntax and bracket pair diagnostics."
        },
        "brainfuck.diagnostics.warnOnEmptyLoops": {
          "type": "boolean",
          "default": true,
          "description": "Display warning diagnostics for empty loop constructs ([])."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "test": "node esbuild.js --test && node --test dist/test/engine.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}

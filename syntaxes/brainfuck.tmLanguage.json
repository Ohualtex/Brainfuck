{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Brainfuck",
  "scopeName": "source.brainfuck",
  "patterns": [
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#commands"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.brainfuck",
      "begin": "\\[(?=[\\s]*[a-zA-Z])",
      "beginCaptures": {
        "0": {
          "name": "comment.block.brainfuck"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "comment.block.brainfuck"
        }
      },
      "patterns": [
        {
          "name": "comment.block.brainfuck",
          "match": "[^\\]]+"
        }
      ]
    },
    "comment-line": {
      "patterns": [
        {
          "name": "comment.line.double-slash.brainfuck",
          "match": "//.*$"
        },
        {
          "name": "comment.line.semicolon.brainfuck",
          "match": ";.*$"
        },
        {
          "name": "comment.line.hash.brainfuck",
          "match": "#[\\s]+.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.brainfuck",
          "match": "[a-zA-Z0-9_]+(?:[.,\\-+][a-zA-Z0-9_]+)*[.,!?:;\"'\\)]*"
        },
        {
          "name": "comment.line.brainfuck",
          "match": "[^><+\\-.,\\[\\]#\\r\\n]+"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "variable.other.constant.pointer.brainfuck",
          "match": "[><]"
        },
        {
          "name": "constant.numeric.arithmetic.brainfuck",
          "match": "[+-]"
        },
        {
          "name": "support.function.io.brainfuck",
          "match": "[.,]"
        },
        {
          "name": "keyword.control.loop.brainfuck",
          "match": "[\\[\\]]"
        },
        {
          "name": "invalid.deprecated.breakpoint.brainfuck",
          "match": "#"
        }
      ]
    }
  }
}

{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\[[^\\]]*$",
    "decreaseIndentPattern": "^\\]"
  }
}

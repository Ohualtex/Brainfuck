{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\[[^\\]]*$",
    "decreaseIndentPattern": "^\\]"
  }
}
